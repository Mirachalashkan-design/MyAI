:root {
  --accent: #9f79bd;
  --accent-2: #edb9d0;
  --accent-3: #bfe4d5;
  --accent-4: #f3dda0;

  --background-1: #e9ddf7;
  --background-2: #fae8f2;
  --background-3: #fff1c8;
  --background-4: #d9f3e8;

  --surface: rgba(255, 255, 255, 0.54);
  --surface-strong: rgba(255, 255, 255, 0.78);
  --surface-soft: rgba(255, 255, 255, 0.34);

  --border: rgba(255, 255, 255, 0.68);
  --border-soft: rgba(255, 255, 255, 0.42);

  --text: #4b3d55;
  --muted: #82748c;
  --heading: #684d78;

  --shadow:
    0 28px 80px rgba(72, 50, 85, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

body.dark {
  --background-1: #211a2a;
  --background-2: #302231;
  --background-3: #383025;
  --background-4: #1f342d;

  --surface: rgba(31, 25, 38, 0.72);
  --surface-strong: rgba(45, 37, 53, 0.9);
  --surface-soft: rgba(255, 255, 255, 0.06);

  --border: rgba(255, 255, 255, 0.12);
  --border-soft: rgba(255, 255, 255, 0.08);

  --text: #f5eef8;
  --muted: #c5b9ca;
  --heading: #eadcf2;

  --shadow:
    0 30px 90px rgba(0, 0, 0, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

body[data-theme="magic"] {
  --accent: #8f6ac8;
  --accent-2: #d1a74d;
  --accent-3: #314f85;
  --accent-4: #f1dc92;

  --background-1: #18162c;
  --background-2: #29234a;
  --background-3: #4a355f;
  --background-4: #192642;

  --surface: rgba(28, 25, 49, 0.66);
  --surface-strong: rgba(38, 32, 67, 0.86);
  --surface-soft: rgba(255, 255, 255, 0.07);

  --border: rgba(240, 218, 145, 0.22);
  --border-soft: rgba(255, 255, 255, 0.09);

  --text: #f5efff;
  --muted: #c9bdd9;
  --heading: #f3d995;
}

body[data-theme="boss"] {
  --accent: #1b4c8c;
  --accent-2: #6da6d8;
  --accent-3: #b5d5ec;
  --accent-4: #d8e8f5;

  --background-1: #e4edf5;
  --background-2: #f8fbfd;
  --background-3: #d8e9f7;
  --background-4: #edf3f7;

  --surface: rgba(255, 255, 255, 0.68);
  --surface-strong: rgba(255, 255, 255, 0.88);
  --surface-soft: rgba(255, 255, 255, 0.44);

  --text: #20344d;
  --muted: #68798c;
  --heading: #163b6c;
}

body[data-theme="club"] {
  --accent: #e57b9b;
  --accent-2: #69b6c4;
  --accent-3: #f1c55e;
  --accent-4: #a9d69c;

  --background-1: #f9e4ed;
  --background-2: #e2f4f2;
  --background-3: #fff0b9;
  --background-4: #e6f4d9;

  --surface: rgba(255, 255, 255, 0.62);
  --surface-strong: rgba(255, 255, 255, 0.82);
  --surface-soft: rgba(255, 255, 255, 0.4);

  --text: #564552;
  --muted: #86727f;
  --heading: #c65478;
}

body[data-theme="yesday"] {
  --accent: #ff6c6c;
  --accent-2: #ffb347;
  --accent-3: #55cfd0;
  --accent-4: #8ed765;

  --background-1: #ffe0e0;
  --background-2: #ffecc7;
  --background-3: #d8f6f6;
  --background-4: #e4f7d7;

  --surface: rgba(255, 255, 255, 0.62);
  --surface-strong: rgba(255, 255, 255, 0.84);
  --surface-soft: rgba(255, 255, 255, 0.38);

  --text: #4b4445;
  --muted: #7f7274;
  --heading: #e34f59;
}

body[data-theme="rainbow"] {
  --accent: #a26be5;
  --accent-2: #f375a8;
  --accent-3: #5ecfbb;
  --accent-4: #f3cd5f;

  --background-1: #e6d8ff;
  --background-2: #ffd8e6;
  --background-3: #fff2bd;
  --background-4: #cdf4eb;

  --surface: rgba(255, 255, 255, 0.54);
  --surface-strong: rgba(255, 255, 255, 0.78);
  --surface-soft: rgba(255, 255, 255, 0.34);

  --text: #4e4057;
  --muted: #82718c;
  --heading: #7651a5;
}

body[data-theme="unicorn"] {
  --accent: #b074d8;
  --accent-2: #f49bc5;
  --accent-3: #8ddbd3;
  --accent-4: #f5d685;

  --background-1: #eadcff;
  --background-2: #ffdff1;
  --background-3: #fff4c9;
  --background-4: #d8f8f2;

  --surface: rgba(255, 255, 255, 0.58);
  --surface-strong: rgba(255, 255, 255, 0.82);
  --surface-soft: rgba(255, 255, 255, 0.36);

  --text: #584562;
  --muted: #89758e;
  --heading: #8d58ae;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  min-height: 100%;
  margin: 0;
}

body {
  min-height: 100vh;
  padding: 22px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  color: var(--text);

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background:
    radial-gradient(
      circle at 8% 12%,
      var(--background-2),
      transparent 34%
    ),
    radial-gradient(
      circle at 92% 12%,
      var(--background-3),
      transparent 31%
    ),
    radial-gradient(
      circle at 86% 88%,
      var(--background-4),
      transparent 36%
    ),
    linear-gradient(
      145deg,
      var(--background-1),
      var(--background-2)
    );

  background-attachment: fixed;

  transition:
    background 0.4s ease,
    color 0.35s ease;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 3px solid color-mix(in srgb, var(--accent) 32%, transparent);
  outline-offset: 2px;
}

.background-decoration {
  position: fixed;
  z-index: 0;
  inset: 0;

  overflow: hidden;
  pointer-events: none;
}

.glow {
  position: absolute;

  border-radius: 50%;
  filter: blur(26px);
  opacity: 0.46;

  animation: floatGlow 10s ease-in-out infinite;
}

.glow-one {
  width: 240px;
  height: 240px;

  top: -80px;
  left: -70px;

  background: var(--accent-2);
}

.glow-two {
  width: 210px;
  height: 210px;

  top: 18%;
  right: -80px;

  background: var(--accent-4);
  animation-delay: -3s;
}

.glow-three {
  width: 260px;
  height: 260px;

  right: 12%;
  bottom: -110px;

  background: var(--accent-3);
  animation-delay: -6s;
}

.floating-symbol {
  position: absolute;

  color: color-mix(in srgb, var(--accent) 58%, white);
  font-size: 25px;
  opacity: 0.48;

  animation: symbolFloat 8s ease-in-out infinite;
}

.symbol-one {
  top: 10%;
  right: 15%;
}

.symbol-two {
  left: 8%;
  bottom: 14%;
  animation-delay: -2s;
}

.symbol-three {
  right: 30%;
  bottom: 8%;
  animation-delay: -4s;
}

@keyframes floatGlow {
  0%,
  100% {
    transform: translate3d(0, 0, 0) scale(1);
  }

  50% {
    transform: translate3d(0, -18px, 0) scale(1.04);
  }
}

@keyframes symbolFloat {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }

  50% {
    transform: translateY(-14px) rotate(8deg);
  }
}

.app-shell {
  position: relative;
  z-index: 2;

  width: min(1220px, 100%);
  height: min(880px, calc(100vh - 44px));

  display: grid;
  grid-template-columns: 290px 1fr;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 34px;

  background: var(--surface);

  box-shadow: var(--shadow);

  backdrop-filter: blur(28px) saturate(135%);
  -webkit-backdrop-filter: blur(28px) saturate(135%);

  transition:
    background 0.35s ease,
    border-color 0.35s ease;
}

.sidebar {
  min-height: 0;
  padding: 20px;

  display: flex;
  flex-direction: column;
  gap: 17px;

  border-right: 1px solid var(--border-soft);

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.27),
      rgba(255, 255, 255, 0.08)
    );
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.brand-logo {
  width: 58px;
  height: 58px;
  flex-shrink: 0;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 20px;

  color: var(--text);

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.88),
      rgba(255, 255, 255, 0.22)
    );

  box-shadow:
    0 12px 26px rgba(72, 48, 85, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);

  font-size: 31px;
  cursor: pointer;
}

.brand-copy {
  min-width: 0;
}

.brand-copy h1 {
  margin: 0;

  color: var(--heading);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 30px;
  letter-spacing: -0.8px;
}

.brand-copy p {
  margin: 3px 0 0;

  color: var(--muted);

  font-size: 10px;
  font-weight: 700;
  line-height: 1.35;
}

.new-chat-button {
  width: 100%;
  min-height: 49px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  border: 0;
  border-radius: 17px;

  color: white;

  background:
    linear-gradient(
      135deg,
      var(--accent),
      var(--accent-2)
    );

  box-shadow:
    0 13px 26px color-mix(in srgb, var(--accent) 22%, transparent);

  font-size: 13px;
  font-weight: 850;
  cursor: pointer;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.new-chat-button:hover {
  transform: translateY(-1px);

  box-shadow:
    0 16px 30px color-mix(in srgb, var(--accent) 28%, transparent);
}

.main-menu {
  min-height: 0;

  display: grid;
  gap: 7px;

  overflow-y: auto;
}

.menu-button {
  width: 100%;
  min-height: 45px;
  padding: 0 13px;

  display: flex;
  align-items: center;
  gap: 11px;

  border: 1px solid transparent;
  border-radius: 15px;

  color: var(--muted);
  background: transparent;

  text-align: left;
  font-size: 13px;
  font-weight: 740;
  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.menu-button:hover {
  color: var(--text);
  background: var(--surface-soft);
  transform: translateX(2px);
}

.menu-button.active {
  border-color: var(--border-soft);

  color: var(--heading);

  background:
    linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 28%, transparent),
      color-mix(in srgb, var(--accent-2) 24%, transparent)
    );

  box-shadow:
    0 10px 22px rgba(73, 51, 85, 0.08);
}

.menu-icon {
  width: 25px;
  flex-shrink: 0;

  text-align: center;
  font-size: 17px;
}

.sidebar-footer {
  margin-top: auto;
}

.mini-profile {
  padding: 12px;

  display: flex;
  align-items: center;
  gap: 10px;

  border: 1px solid var(--border-soft);
  border-radius: 17px;

  background: var(--surface-soft);
}

.mini-avatar {
  width: 39px;
  height: 39px;
  flex-shrink: 0;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 14px;

  background: var(--surface-strong);

  font-size: 19px;
  font-weight: 800;
}

.mini-profile strong,
.mini-profile span {
  display: block;
}

.mini-profile strong {
  color: var(--text);
  font-size: 11px;
}

.mini-profile span {
  margin-top: 3px;

  color: var(--muted);
  font-size: 9px;
}

.main-area {
  min-width: 0;
  min-height: 0;

  display: flex;
  flex-direction: column;
}

.topbar {
  min-height: 84px;
  padding: 16px 20px;

  display: flex;
  align-items: center;
  gap: 12px;

  border-bottom: 1px solid var(--border-soft);

  background: rgba(255, 255, 255, 0.08);
}

.mobile-menu-button {
  display: none;
}

.page-heading {
  min-width: 0;
  flex: 1;
}

.page-heading h2 {
  margin: 0;

  color: var(--heading);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 24px;
}

.page-heading p {
  margin: 4px 0 0;

  color: var(--muted);

  font-size: 11px;
  font-weight: 650;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.topbar-button {
  width: 43px;
  height: 43px;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 14px;

  color: var(--text);
  background: var(--surface-soft);

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.38);

  font-size: 18px;
  cursor: pointer;
}

.workspace {
  min-height: 0;
  flex: 1;

  display: flex;
}

.panel {
  min-width: 0;
  min-height: 0;
  flex: 1;

  display: none;
  flex-direction: column;
}

.panel.active {
  display: flex;
}

.chat-scroll,
.panel-scroll {
  min-height: 0;
  flex: 1;

  padding: 24px;

  overflow-y: auto;
  scroll-behavior: smooth;
}

.welcome-card {
  max-width: 750px;
  margin: 6px auto 22px;

  text-align: center;
}

.welcome-icon {
  width: 78px;
  height: 78px;
  margin: 0 auto 14px;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 27px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.82),
      rgba(255, 255, 255, 0.22)
    );

  box-shadow:
    0 16px 36px rgba(74, 52, 87, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.82);

  font-size: 40px;
}

.eyebrow {
  margin: 0 0 5px;

  color: var(--accent);

  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.3px;
  text-transform: uppercase;
}

.welcome-card h3,
.section-intro h3 {
  margin: 0;

  color: var(--heading);

  font-family:
    Georgia,
    "Times New Roman",
    serif;
}

.welcome-card h3 {
  font-size: clamp(34px, 5vw, 50px);
  letter-spacing: -1.5px;
}

.welcome-card > p:not(.eyebrow) {
  max-width: 590px;
  margin: 10px auto 0;

  color: var(--muted);

  font-size: 13px;
  line-height: 1.6;
}

.mode-badges {
  margin-top: 15px;

  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 7px;
}

.mode-badges span {
  padding: 7px 10px;

  border: 1px solid var(--border-soft);
  border-radius: 999px;

  color: var(--muted);
  background: var(--surface-soft);

  font-size: 9px;
  font-weight: 800;
}

.quick-actions {
  max-width: 820px;
  margin: 0 auto 23px;

  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.quick-card {
  min-height: 112px;
  padding: 14px;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  border: 1px solid var(--border-soft);
  border-radius: 20px;

  color: var(--text);
  background: var(--surface-soft);

  text-align: left;
  cursor: pointer;

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}

.quick-card:hover {
  transform: translateY(-2px);
  background: var(--surface-strong);
}

.quick-card > span {
  margin-bottom: auto;
  font-size: 23px;
}

.quick-card strong {
  margin-top: 13px;
  font-size: 12px;
}

.quick-card small {
  margin-top: 4px;

  color: var(--muted);

  font-size: 9px;
  line-height: 1.35;
}

.messages {
  max-width: 820px;
  margin: 0 auto;

  display: flex;
  flex-direction: column;
  gap: 12px;
}

.message-row {
  display: flex;
  align-items: flex-end;
  gap: 9px;
}

.user-row {
  justify-content: flex-end;
}

.message-avatar {
  width: 33px;
  height: 33px;
  flex-shrink: 0;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 12px;

  background: var(--surface-strong);

  font-size: 16px;
}

.message {
  max-width: 76%;
  padding: 12px 14px;

  border: 1px solid var(--border-soft);
  border-radius: 19px;

  font-size: 13px;
  line-height: 1.55;

  box-shadow:
    0 8px 20px rgba(70, 49, 82, 0.07);
}

.mimi-message {
  border-bottom-left-radius: 6px;

  background:
    linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 23%, white),
      color-mix(in srgb, var(--accent-2) 22%, white)
    );
}

.user-message {
  border-bottom-right-radius: 6px;

  color: white;

  background:
    linear-gradient(
      135deg,
      var(--accent),
      var(--accent-2)
    );
}

.composer-area {
  padding: 14px 20px 18px;

  border-top: 1px solid var(--border-soft);

  background: rgba(255, 255, 255, 0.07);
}

.composer {
  max-width: 850px;
  margin: auto;
  padding: 8px;

  display: flex;
  align-items: flex-end;
  gap: 8px;

  border: 1px solid var(--border);
  border-radius: 21px;

  background: var(--surface-strong);

  box-shadow:
    0 16px 36px rgba(70, 49, 82, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.45);
}

.composer-icon-button {
  width: 43px;
  height: 43px;
  flex-shrink: 0;

  border: 1px solid var(--border-soft);
  border-radius: 14px;

  color: var(--text);
  background: var(--surface-soft);

  font-size: 17px;
  cursor: pointer;
}

#messageInput {
  min-width: 0;
  max-height: 130px;
  flex: 1;

  padding: 11px 6px;

  resize: none;

  border: 0;
  outline: 0;

  color: var(--text);
  background: transparent;

  font-size: 13px;
  line-height: 1.45;
}

#messageInput::placeholder,
input::placeholder,
textarea::placeholder {
  color: var(--muted);
}

.send-button {
  min-width: 76px;
  height: 43px;

  border: 0;
  border-radius: 14px;

  color: white;

  background:
    linear-gradient(
      135deg,
      var(--accent),
      var(--accent-2)
    );

  font-size: 12px;
  font-weight: 850;
  cursor: pointer;
}

.composer-note {
  margin: 7px 0 0;

  color: var(--muted);

  text-align: center;
  font-size: 9px;
}

.section-intro {
  max-width: 930px;
  margin: 0 auto 18px;

  display: flex;
  align-items: center;
  gap: 14px;
}

.section-icon {
  width: 60px;
  height: 60px;
  flex-shrink: 0;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 20px;

  background: var(--surface-strong);

  font-size: 29px;
}

.section-intro h3 {
  font-size: 30px;
}

.section-intro > div:last-child > p:last-child {
  margin: 6px 0 0;

  color: var(--muted);

  font-size: 11px;
  line-height: 1.5;
}

.profile-form,
.theme-grid,
.studio-layout,
.settings-list,
.custom-color-card {
  max-width: 930px;
  margin-left: auto;
  margin-right: auto;
}

.profile-form {
  display: grid;
  gap: 15px;
}

.form-card,
.custom-color-card {
  padding: 19px;

  border: 1px solid var(--border);
  border-radius: 24px;

  background: var(--surface-soft);

  box-shadow:
    0 14px 32px rgba(72, 50, 84, 0.08);
}

.card-heading {
  margin-bottom: 15px;

  display: flex;
  align-items: center;
  gap: 11px;
}

.card-heading > span {
  font-size: 24px;
}

.card-heading h4,
.custom-color-card h4 {
  margin: 0;

  color: var(--heading);

  font-size: 15px;
}

.card-heading p,
.custom-color-card p {
  margin: 4px 0 0;

  color: var(--muted);

  font-size: 10px;
  line-height: 1.4;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 13px;
}

.field {
  display: grid;
  gap: 7px;

  color: var(--text);

  font-size: 10px;
  font-weight: 800;
}

.field input,
.field textarea,
.field select,
.select-row select {
  width: 100%;
  padding: 12px 13px;

  border: 1px solid var(--border);
  border-radius: 14px;
  outline: 0;

  color: var(--text);
  background: var(--surface-strong);

  font-size: 12px;
}

.field textarea {
  resize: vertical;
  line-height: 1.5;
}

.choice-grid {
  margin-bottom: 14px;

  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}

.choice {
  padding: 11px;

  display: flex;
  align-items: center;
  gap: 8px;

  border: 1px solid var(--border-soft);
  border-radius: 14px;

  color: var(--text);
  background: var(--surface-soft);

  font-size: 10px;
  font-weight: 750;
  cursor: pointer;
}

.choice input {
  accent-color: var(--accent);
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
}

.primary-button,
.secondary-button {
  min-height: 43px;
  padding: 0 16px;

  border-radius: 14px;

  font-size: 11px;
  font-weight: 850;
  cursor: pointer;
}

.primary-button {
  border: 0;

  color: white;

  background:
    linear-gradient(
      135deg,
      var(--accent),
      var(--accent-2)
    );
}

.secondary-button {
  border: 1px solid var(--border);

  color: var(--text);
  background: var(--surface-soft);
}

.full-width {
  width: 100%;
  margin-top: 13px;
}

.save-message {
  min-height: 18px;
  margin: 0;

  color: var(--accent);

  text-align: right;
  font-size: 10px;
  font-weight: 800;
}

.theme-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13px;
}

.theme-card {
  padding: 11px;

  border: 1px solid var(--border-soft);
  border-radius: 20px;

  color: var(--text);
  background: var(--surface-soft);

  text-align: left;
  cursor: pointer;

  transition:
    transform 0.2s ease,
    border-color 0.2s ease;
}

.theme-card:hover {
  transform: translateY(-2px);
}

.theme-card.selected {
  border-color: color-mix(in srgb, var(--accent) 60%, white);

  box-shadow:
    0 0 0 3px color-mix(in srgb, var(--accent) 13%, transparent);
}

.theme-preview {
  height: 105px;
  margin-bottom: 10px;

  display: grid;
  place-items: center;

  border-radius: 15px;

  font-size: 37px;
}

.theme-mimi {
  background:
    linear-gradient(
      135deg,
      #dcc8f1,
      #f6cedf,
      #f7e5ad,
      #ccecdf
    );
}

.theme-magic {
  background:
    radial-gradient(circle at 30% 30%, #6b4c91, transparent 30%),
    linear-gradient(145deg, #17142b, #403059);
}

.theme-boss {
  background:
    linear-gradient(
      135deg,
      #1a477e,
      #d9edf8
    );
}

.theme-club {
  background:
    linear-gradient(
      135deg,
      #f29ab3,
      #8ad2d5,
      #f3d268
    );
}

.theme-yesday {
  background:
    linear-gradient(
      135deg,
      #ff7373,
      #ffbd55,
      #5fd4ce,
      #96dc70
    );
}

.theme-rainbow {
  background:
    linear-gradient(
      135deg,
      #a16ae8,
      #f67da9,
      #f2ce65,
      #62d4b5
    );
}

.theme-unicorn {
  background:
    radial-gradient(circle at 30% 30%, white, transparent 18%),
    linear-gradient(
      135deg,
      #d5b4f4,
      #f6b9d7,
      #f5df9a,
      #aee7dc
    );
}

.theme-card strong,
.theme-card small {
  display: block;
}

.theme-card strong {
  font-size: 11px;
}

.theme-card small {
  margin-top: 4px;

  color: var(--muted);

  font-size: 9px;
  line-height: 1.35;
}

.custom-color-card {
  margin-top: 15px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.color-control {
  display: flex;
  align-items: center;
  gap: 9px;
}

#customAccentColor {
  width: 48px;
  height: 43px;
  padding: 3px;

  border: 1px solid var(--border);
  border-radius: 13px;

  background: var(--surface-strong);
  cursor: pointer;
}

.studio-layout {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 16px;
}

.style-options {
  margin-top: 11px;

  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.style-chip {
  padding: 8px 10px;

  border: 1px solid var(--border-soft);
  border-radius: 999px;

  color: var(--muted);
  background: var(--surface-soft);

  font-size: 9px;
  font-weight: 800;
  cursor: pointer;
}

.style-chip.selected {
  color: var(--heading);

  background:
    color-mix(in srgb, var(--accent) 20%, transparent);
}

.image-preview {
  min-height: 395px;
  padding: 20px;

  display: grid;
  place-items: center;
  align-content: center;

  border: 1px solid var(--border);
  border-radius: 24px;

  text-align: center;

  background:
    radial-gradient(
      circle at 18% 20%,
      color-mix(in srgb, var(--accent-2) 72%, white),
      transparent 35%
    ),
    radial-gradient(
      circle at 82% 18%,
      color-mix(in srgb, var(--accent-4) 72%, white),
      transparent 32%
    ),
    radial-gradient(
      circle at 80% 82%,
      color-mix(in srgb, var(--accent-3) 72%, white),
      transparent 36%
    ),
    linear-gradient(
      145deg,
      color-mix(in srgb, var(--accent) 42%, white),
      color-mix(in srgb, var(--accent-2) 35%, white)
    );

  box-shadow:
    0 15px 34px rgba(72, 50, 84, 0.09);
}

.preview-emoji {
  font-size: 50px;
}

.image-preview strong {
  margin-top: 9px;

  color: var(--heading);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 25px;
}

.image-preview p {
  max-width: 320px;
  margin: 8px auto 0;

  color: var(--muted);

  font-size: 11px;
  line-height: 1.5;
}

.settings-list {
  display: grid;
  gap: 11px;
}

.setting-row {
  min-height: 74px;
  padding: 15px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 13px;

  border: 1px solid var(--border);
  border-radius: 19px;

  background: var(--surface-soft);
}

.setting-row strong,
.setting-row span {
  display: block;
}

.setting-row strong {
  color: var(--text);
  font-size: 11px;
}

.setting-row span {
  margin-top: 4px;

  color: var(--muted);

  font-size: 9px;
}

.switch-input {
  width: 44px;
  height: 24px;
  flex-shrink: 0;

  accent-color: var(--accent);
  cursor: pointer;
}

.select-row select {
  width: auto;
  min-width: 145px;
}

.center-content {
  display: grid;
  place-items: center;
}

.empty-state {
  max-width: 480px;
  padding: 30px;

  border: 1px solid var(--border);
  border-radius: 25px;

  text-align: center;

  background: var(--surface-soft);
}

.empty-icon {
  font-size: 43px;
}

.empty-state h3 {
  margin: 12px 0 8px;

  color: var(--heading);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 27px;
}

.empty-state p {
  margin: 0 0 16px;

  color: var(--muted);

  font-size: 11px;
  line-height: 1.6;
}

.mobile-overlay {
  display: none;
}

.toast {
  position: fixed;
  z-index: 100;

  right: 20px;
  bottom: 20px;

  max-width: min(340px, calc(100vw - 40px));
  padding: 12px 15px;

  border: 1px solid var(--border);
  border-radius: 15px;

  color: var(--text);
  background: var(--surface-strong);

  box-shadow:
    0 16px 38px rgba(57, 40, 68, 0.2);

  font-size: 11px;
  font-weight: 750;

  opacity: 0;
  pointer-events: none;
  transform: translateY(12px);

  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.toast.show {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 940px) {
  body {
    padding: 0;
  }

  .app-shell {
    width: 100%;
    height: 100vh;

    grid-template-columns: 1fr;

    border: 0;
    border-radius: 0;
  }

  .sidebar {
    position: fixed;
    z-index: 50;

    top: 0;
    bottom: 0;
    left: 0;

    width: min(300px, 86vw);

    transform: translateX(-105%);
    transition: transform 0.25s ease;

    border-right: 1px solid var(--border);

    background: var(--surface-strong);

    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .mobile-overlay {
    position: fixed;
    z-index: 45;
    inset: 0;

    background: rgba(30, 24, 35, 0.28);

    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .mobile-overlay.open {
    display: block;
  }

  .mobile-menu-button {
    width: 43px;
    height: 43px;
    padding: 0;

    display: grid;
    place-items: center;

    border: 1px solid var(--border);
    border-radius: 14px;

    color: var(--text);
    background: var(--surface-soft);

    cursor: pointer;
  }

  .quick-actions {
    grid-template-columns: repeat(2, 1fr);
  }

  .theme-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .studio-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .topbar {
    min-height: 73px;
    padding: 11px 12px;
  }

  .page-heading h2 {
    font-size: 19px;
  }

  .page-heading p {
    display: none;
  }

  .topbar-button {
    width: 40px;
    height: 40px;
  }

  .chat-scroll,
  .panel-scroll {
    padding: 17px 12px;
  }

  .welcome-icon {
    width: 66px;
    height: 66px;

    border-radius: 22px;

    font-size: 34px;
  }

  .welcome-card h3 {
    font-size: 35px;
  }

  .welcome-card > p:not(.eyebrow) {
    font-size: 11px;
  }

  .quick-actions {
    gap: 8px;
  }

  .quick-card {
    min-height: 101px;
    padding: 12px;
  }

  .message {
    max-width: 87%;
  }

  .composer-area {
    padding: 9px;
  }

  .composer {
    padding: 6px;
  }

  .composer-icon-button {
    width: 39px;
    height: 39px;
  }

  .composer-icon-button:nth-of-type(2) {
    display: none;
  }

  .send-button {
    min-width: 68px;
    height: 39px;
  }

  .section-intro {
    align-items: flex-start;
  }

  .section-icon {
    width: 52px;
    height: 52px;

    border-radius: 17px;

    font-size: 25px;
  }

  .section-intro h3 {
    font-size: 25px;
  }

  .form-grid,
  .choice-grid {
    grid-template-columns: 1fr;
  }

  .theme-grid {
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .theme-preview {
    height: 86px;
  }

  .custom-color-card {
    align-items: flex-start;
    flex-direction: column;
  }

  .color-control {
    width: 100%;
  }

  .color-control .primary-button {
    flex: 1;
  }

  .setting-row {
    align-items: flex-start;
  }

  .select-row {
    flex-direction: column;
  }

  .select-row select {
    width: 100%;
  }
}

@media (max-width: 390px) {
  .theme-grid {
    grid-template-columns: 1fr;
  }

  .quick-card small {
    display: none;
  }

  .mode-badges span:last-child {
    display: none;
  }
}
